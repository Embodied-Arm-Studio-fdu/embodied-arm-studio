# Reference only. Generate real secrets with: python3 scripts/self_host.py init
STUDIO_DEPLOY_MODE='core'
STUDIO_PROJECT_NAME='embodied-arm-selfhost'
STUDIO_BIND_ADDRESS='127.0.0.1'
STUDIO_HTTP_PORT='8080'
STUDIO_PUBLIC_HOST=''
STUDIO_WEB_ORIGIN='http://localhost:8080'
STUDIO_STREAM_ORIGIN='http://localhost:18889'
STUDIO_GPU_DEVICE='0'
ISAAC_GYM_PATH=''
S1_ASSETS_PATH=''
REFERENCE_MODELS_PATH=''
POSTGRES_PASSWORD='<generated-by-init>'
USER_JWT_SECRET='<generated-by-init>'
SIMULATION_SERVICE_TOKEN='<generated-by-init>'
INTERNAL_RUN_EVENT_SERVICE_TOKEN='<generated-by-init>'
OPENAI_API_KEY=''
OPENAI_MODEL=''
OPENAI_BASE_URL='https://api.openai.com/v1'
DEEPSEEK_API_KEY=''
DEEPSEEK_MODEL=''
ANTHROPIC_API_KEY=''
ANTHROPIC_MODEL=''

# Browser-reachable media ports; internal WHEP port remains 18889.
STUDIO_MEDIA_HTTP_PORT='18889'
STUDIO_MEDIA_UDP_PORT='18189'
STUDIO_MEDIA_TCP_PORT='18191'
# Unset uses :STUDIO_MEDIA_UDP_PORT; empty disables UDP ICE for SSH/TCP-only.
STUDIO_MEDIA_UDP_ADDRESS=':18189'
# Opt in only for localhost/SSH forwarding; exact web-origin restriction remains.
STUDIO_ALLOW_LOOPBACK_PLAYBACK='0'
# Both worker and gpu-check select the shipped, validated NVIDIA EGL ICD.
STUDIO_VULKAN_ICD='/app/deploy/nvidia-egl-icd.json'
